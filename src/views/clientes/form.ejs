<%
layout('layouts/main', { title: title, user: user });
%>

<div class="card">
    <div class="card-header">
        <h2><%= cliente ? 'Editar Cliente' : 'Novo Cliente' %></h2>
    </div>
    <div class="card-body">
        <form action="<%= action %>" method="POST">
            <div class="form-group">
                <label for="nome">Nome completo *</label>
                <input type="text" id="nome" name="nome" class="form-control" 
                       value="<%= cliente ? cliente.nome : '' %>" required>
            </div>

            <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" class="form-control" 
                       value="<%= cliente ? cliente.email : '' %>" 
                       <%= cliente ? 'readonly disabled' : 'required' %>>
                <% if (cliente) { %>
                    <small class="text-muted">O email não pode ser alterado.</small>
                <% } %>
            </div>

            <div class="form-group">
                <label for="endereco">Endereço</label>
                <input type="text" id="endereco" name="endereco" class="form-control" 
                       value="<%= cliente ? cliente.endereco : '' %>">
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="/clientes" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
