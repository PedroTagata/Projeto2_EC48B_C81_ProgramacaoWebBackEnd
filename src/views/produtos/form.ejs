<%
layout('layouts/main', { title: title, user: user });
%>

<div class="card">
    <div class="card-header">
        <h2><%= produto ? 'Editar Produto' : 'Novo Produto' %></h2>
    </div>
    <div class="card-body">
        <form action="<%= action %>" method="POST">
            <div class="form-group">
                <label for="nome">Nome do produto *</label>
                <input type="text" id="nome" name="nome" class="form-control" 
                       value="<%= produto ? produto.nome : '' %>" required>
            </div>

            <div class="form-group">
                <label for="descricao">Descrição</label>
                <textarea id="descricao" name="descricao" class="form-control" rows="4"><%= produto ? produto.descricao : '' %></textarea>
            </div>

            <div class="form-group">
                <label for="preco">Preço (R$) *</label>
                <input type="number" step="0.01" id="preco" name="preco" class="form-control" 
                       value="<%= produto ? produto.preco : '' %>" required>
            </div>

            <div class="form-group">
                <label for="estoque">Estoque *</label>
                <input type="number" id="estoque" name="estoque" class="form-control" 
                       value="<%= produto ? produto.estoque : '' %>" required>
            </div>

            <div class="form-group">
                <label for="categoria">Categoria</label>
                <input type="text" id="categoria" name="categoria" class="form-control" 
                       value="<%= produto ? produto.categoria : '' %>" list="categorias-sugeridas">
                <datalist id="categorias-sugeridas">
                    <option>Eletrônicos</option>
                    <option>Acessórios</option>
                    <option>Wearables</option>
                    <option>Games</option>
                    <option>Casa e Cozinha</option>
                </datalist>
            </div>

            <div style="display: flex; gap: 1rem; margin-top: 1.5rem;">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a href="/produtos" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
